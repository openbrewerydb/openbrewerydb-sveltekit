{
  "name": "openbrewerydb-sveltekit",
  "version": "1.1.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run search-suggestions:build && vite build",
    "data:build": "npm run authors:build && npm run changelogs:build && npm run contributors:build && npm run search-suggestions:build",
    "authors:build": "node scripts/build-authors.mjs",
    "changelogs:build": "node scripts/build-changelogs.mjs",
    "contributors:build": "node scripts/build-contributors.mjs",
    "search-suggestions:build": "node scripts/build-search-suggestions.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint --ignore-pattern .gitignore .",
    "lint:fix": "prettier --check . && eslint --ignore-pattern .gitignore . --fix",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "deps:check": "npm install-scripts ls && npm outdated",
    "deps:update": "npm update --save --min-release-age=7 && npm install-scripts prune && npm install-scripts ls",
    "postdeps:update": "npm outdated || echo 'Above: packages still behind latest (Wanted < Latest = outside ^ range, usually a major). Apply manually: npm i <pkg>@latest'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/sveltekit": "^10.76.2",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-urls": "^1.2.0",
    "remark-abbr": "^1.4.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@lucide/svelte": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "layerchart": "^2.8.1"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "^3.1.0"
    }
  },
  "allowScripts": {
    "@sentry/cli": true,
    "esbuild": true,
    "workerd": true
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
